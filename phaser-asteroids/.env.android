# Loaded ONLY by `vite build --mode android` (npm run build:android). Browser builds and GitHub Pages never read this file.
#
# The Android app talks to the production leaderboard Worker, always. scripts/build-android.mjs refuses to build if this is missing,
# not https, a loopback / private address, or contradicted by a different VITE_LEADERBOARD_API_URL in the shell environment, and
# checks afterwards that this exact origin is in the bundle. Public value (it ships inside every web build anyway).
VITE_LEADERBOARD_API_URL=https://asteroids-leaderboard.davejandrea.workers.dev
