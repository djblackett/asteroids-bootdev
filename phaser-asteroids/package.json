{
  "name": "phaser-asteroids",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --config vite.lan.config.ts",
    "build": "tsc --noEmit && vite build && vite build --outDir dist/node --target node20 --ssr src/replay/index.ts",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:replay:browser": "npm run build && node scripts/replay-browser.mjs",
    "benchmark:replay": "npm run build && node scripts/benchmark-replay.mjs",
    "test:browser": "npm run build && node scripts/smoke.mjs",
    "test:input": "npm run build && node scripts/keyboard.mjs",
    "test:combat": "npm run build && node scripts/combat.mjs",
    "test:coop": "npm run build && node scripts/coop.mjs",
    "test:gamepad": "npm run build && node scripts/gamepad.mjs",
    "test:touch": "npm run build && node scripts/touch.mjs",
    "test:music": "npm run build && node scripts/music.mjs",
    "test:menu": "npm run build && node scripts/menu.mjs",
    "test:mobile-entry": "npm run build && node scripts/mobile-entry.mjs",
    "test:pages": "npm run build && node scripts/pages-check.mjs",
    "test:server": "vitest run server/tests",
    "test:ranked": "npm run build && node scripts/ranked-browser.mjs",
    "test:ranked:ui": "npm run build && node scripts/ranked-ui.mjs",
    "test:lan": "node scripts/lan-check.mjs",
    "test:worker": "npm run build && node server/scripts/worker-e2e.mjs",
    "bench:workerd": "npm run build && node server/scripts/bench-workerd.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
